stateDiagram-v2
    state "Init" as s0
    state "Attempt#1" as s1
    state "Failed(CarrierUnresponsive)" as s2
    state "Completed(Delivered)" as s3
    state "Delivery.backoff1" as s4
    state "Aborted(Killed)" as s5
    state "Attempt#2" as s6
    state "Delivery.backoff2" as s7
    state "Attempt#3" as s8
    state "Return" as s9
    state "Failed(LostInTransit)" as s10
    state "Completed(ReturnedToSender)" as s11
    [*] --> s0
    s0 --> s1 : ShipmentDispatched
    s1 --> s2 : TimerFired(Attempt#1.T)
    s1 --> s3 : Delivered
    s1 --> s4 : DeliveryAttemptFailed
    s4 --> s6 : TimerFired(Delivery.backoff1.T)
    s6 --> s2 : TimerFired(Attempt#2.T)
    s6 --> s3 : Delivered
    s6 --> s7 : DeliveryAttemptFailed
    s7 --> s8 : TimerFired(Delivery.backoff2.T)
    s8 --> s2 : TimerFired(Attempt#3.T)
    s8 --> s3 : Delivered
    s8 --> s9 : DeliveryAttemptFailed
    s9 --> s10 : TimerFired(Return.T)
    s9 --> s11 : ReturnedToSender
    s2 --> [*]
    s3 --> [*]
    s5 --> [*]
    s10 --> [*]
    s11 --> [*]
    %% Every wait state also accepts Kill --> Aborted(Killed) (omitted for readability)
